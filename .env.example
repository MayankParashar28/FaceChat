# Copy to `.env` and fill in real values. NEVER commit the real .env.
# NOTE: VITE_* vars are read at BUILD time (Vite inlines them into the bundle).
# On Render they must be set as service env vars, or the client ships broken.
# ---------------------------------------------------------------------------

# --------------------------
# Server
# --------------------------
NODE_ENV=development
PORT=3000
# Comma-separated allowed origins in production (e.g. https://your-app.onrender.com)
CORS_ORIGIN=
# trace|debug|info|warn|error (default: debug in dev, info in prod)
LOG_LEVEL=
SESSION_SECRET=

# --------------------------
# MongoDB (Atlas: allow your host's egress IPs)
# --------------------------
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/dbname

# --------------------------
# Firebase Admin SDK (server). Either the single JSON blob (preferred on
# hosted deploys) OR the three individual fields.
# --------------------------
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_DATABASE_URL=

# --------------------------
# Firebase Client SDK (BUILD TIME — required, app won't start without these)
# --------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_URL=
VITE_USE_FIREBASE_EMULATOR=false

# --------------------------
# WebRTC TURN relay (BUILD TIME). Optional, but without it calls fail for
# users behind symmetric NAT (many mobile/corporate networks).
# Providers: Twilio, Metered, Cloudflare Calls, or self-hosted coturn.
# --------------------------
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# --------------------------
# OpenAI (server-side Whisper live captions)
# --------------------------
OPENAI_API_KEY=

# --------------------------
# Cloudinary (chat attachments). Optional.
# Without these the app stores attachments in MongoDB GridFS instead, which
# works but streams every file through this server. With them, files are
# served from Cloudinary's CDN, resized and in a modern format.
# Find all three on the Cloudinary dashboard under "Product Environment
# Credentials". The free plan needs no card: 25 credits/month, where one
# credit is ~1GB of storage OR ~1GB of delivery OR ~1000 transformations.
# --------------------------
# Either paste the single CLOUDINARY_URL the dashboard shows you...
CLOUDINARY_URL=
# ...or set the three parts separately (easier to manage on a host like Render).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
